# ----- Core -----
# Your Postgres connection string (local or cloud e.g. Neon/Supabase/RDS)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hello22?schema=public"
# Direct, UNPOOLED connection — used ONLY by the Prisma CLI (migrate, db push,
# introspect, studio), never by the running app. Those commands take a
# session-level advisory lock that a transaction-mode pooler (Neon/Supabase
# PgBouncer) cannot hold, so pointing them at a pooled DATABASE_URL fails with
# "P1002 ... Timed out trying to acquire a postgres advisory lock".
# On Neon: same string as DATABASE_URL with the `-pooler` suffix removed from
# the host. Not pooling? Just copy DATABASE_URL verbatim.
# REQUIRED wherever the CLI runs, including the Render build (`render:build`).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/hello22?schema=public"

PORT=4000
# Super admin created automatically during database setup.
SEED_SUPER_ADMIN_EMAIL="superadmin@ai.com"
SEED_SUPER_ADMIN_PASSWORD="Super@001"
SEED_SUPER_ADMIN_NAME="Super Admin"
# Comma-separated allowed origins for CORS (the Vite app)
CORS_ORIGIN="http://localhost:5174"
# Public base URL of the app — used for login links in account emails
# (staff/reseller credentials). Falls back to CORS_ORIGIN, then the prod URL.
APP_URL="https://agent.hello22.ai"
# Public base URL of THIS API — used for the email unsubscribe link (must be
# reachable from any inbox / one-click List-Unsubscribe). Falls back to
# VAPI_SERVER_URL, then the local dev port.
PUBLIC_API_URL="https://api.hello22.ai"
# Host shown in the "More info" link of the summary SMS. Set to a brand/short
# domain that proxies /c/* to this API (e.g. a Vercel rewrite on the app domain)
# so the SMS masks the raw API host. Blank → falls back to PUBLIC_API_URL.
SHARE_LINK_BASE_URL="https://agent.hello22.ai"

# ----- White-label domains -----
# The apex whose WILDCARD DNS record points at this deployment. A brand's slug
# becomes a label under it (acme -> acme.hello22.ai), and ONLY hosts under this
# apex are read as brand subdomains — without that anchor, the leading label of
# any hostname would resolve a tenant, so `acme.attacker.com` would be served
# Acme's branding and admitted by the brand-aware CORS check.
# Comma-separate to keep a second apex (staging, or one you're migrating off)
# resolving its tenants. The FIRST entry is the one new brands are minted under.
#
# One-time setup, then every brand is live the moment it's created:
#   1. DNS:    *.hello22.ai  CNAME  cname.vercel-dns.com
#   2. Vercel: add `*.hello22.ai` as a domain on the project (issues the
#              wildcard certificate; needs DNS-01, which Vercel handles).
PLATFORM_DOMAIN="hello22.ai"

# LOCALLY you do not set this to localhost — outside production `localhost` is
# added as an apex automatically, so http://acme.localhost:5174 opens brand
# "acme" with no configuration and no hosts file (browsers resolve *.localhost
# to loopback themselves). That matters: a brand opened on a host the API does
# not recognise is painted as the PLATFORM, and anyone signing up there is
# created as a platform customer rather than the brand's.
#
# To test a brand's own VANITY domain locally, point it at 127.0.0.1 in your
# hosts file and set this — a dev machine can never publish the real TXT record
# the verification needs. Refused in production.
ALLOW_UNVERIFIED_BRAND_DOMAINS=""

# What a BRAND's own domain (app.acmevoice.com) is pointed at. Handed to the
# client as a copy-paste record and checked against live DNS on verification.
BRAND_CNAME_TARGET="cname.vercel-dns.com"
# A-record target for a brand that insists on a root domain — CNAME is illegal
# at an apex (RFC 1034). Prefer asking for a subdomain instead.
BRAND_APEX_IP="76.76.21.21"
# Label the ownership-proof TXT record lives under. LEAVE BLANK: both the record
# name and its value are derived from PLATFORM_DOMAIN, so they always carry YOUR
# name and there is nothing to keep in step. With PLATFORM_DOMAIN=peelcases.com
# the client is handed:
#   _peelcases-verify.app.client.com  TXT  peelcases-verify=<per-brand token>
# Set it only to keep an older name working; changing it invalidates any proof
# already published, so a domain mid-verification must republish.
DOMAIN_VERIFY_PREFIX=""

# Vercel Domains API — lets claiming a brand domain register the hostname with
# the edge (and start its certificate) without anyone opening the dashboard.
# Token needs project read/write. Leave blank and domains still VERIFY by DNS
# lookup, but the operator must add each hostname in Vercel by hand.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
# Only for team-owned projects; leave blank on a personal account.
VERCEL_TEAM_ID=""

# The ONE public API origin third parties are registered against — Google's
# OAuth redirect URI and provider webhooks. Deliberately NOT per-brand: Google
# requires an exact pre-registered redirect_uri, so every tenant's consent comes
# back here and is bounced to the brand using the origin in the signed state.
# Blank -> falls back to PUBLIC_API_URL, then VAPI_SERVER_URL.
CANONICAL_API_URL="https://api.hello22.ai"


# ----- What lives where -----
# A brand's domain — its platform subdomain or its own vanity domain — serves
# the SPA and NOTHING else. Every brand's app is the same build, with
# VITE_API_URL pointing at THIS API's host, so the backend, the Vapi / Twilio /
# Stripe / WhatsApp webhooks, the Google OAuth callback and the public /c/*
# call pages stay on the platform's own domain for every tenant. Creating a
# brand provisions nothing API-side: no DNS, no certificate, no webhook
# re-registration. Pending vanity domains are re-checked every 5 minutes and
# promote themselves once the client's records land.

# JWT signing secret — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Encrypts integration API keys stored in the DB (Admin → Settings).
# Optional — falls back to JWT_SECRET. Set a dedicated 32+ char value in prod.
SETTINGS_ENCRYPTION_KEY=""

# Integration keys below are FALLBACKS/defaults — the admin can override them
# at runtime from Admin → Settings (stored encrypted in the DB).

# ----- OpenAI (support chat assistant) -----
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"

# ----- Vapi (voice agent) -----
VAPI_API_KEY=""
# Server-side fallback for the Vapi public/browser key (in-browser test calls).
# NOTE: the FRONTEND reads VITE_VAPI_PUBLIC_KEY; this backend fallback is VAPI_PUBLIC_KEY.
VAPI_PUBLIC_KEY=""
# Public https base URL Vapi posts call events (status/transfer/end-of-call) to,
# at `${VAPI_SERVER_URL}/api/calls/webhook/vapi`. Must be publicly reachable —
# localhost won't work. Local dev: set NGROK_AUTHTOKEN and run `npm run dev` to
# auto-fill this from an ngrok tunnel. Prod: set your deployed API base URL.
NGROK_AUTHTOKEN=""
NGROK_DOMAIN=""
VAPI_SERVER_URL=""
# Base URL of this API; falls back to VAPI_SERVER_URL when blank.
PUBLIC_API_URL=""

# ----- Deepgram (TTS for voice samples + guided onboarding + AI-Brain preview) -----
# Aura-2 voices. NOTE: live/test CALL voice is played by Vapi's own Deepgram
# (provider "deepgram", model "aura-2") — this key is only for the in-app TTS
# previews (/api/tts), not for calls.
DEEPGRAM_API_KEY=""

# ----- ElevenLabs (optional alternative TTS provider) -----
# Only used when the admin flips the voice-provider toggle (Admin → Settings) to
# ElevenLabs. When active it replaces Deepgram for BOTH previews (/api/tts) and
# the live/test call voice (Vapi provider "11labs"). Leave blank to stay on Deepgram.
ELEVENLABS_API_KEY=""

# ----- Stripe (billing) -----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PREMIUM=""
STRIPE_SUCCESS_URL="http://localhost:5174/dashboard/settings?upgrade=success"
STRIPE_CANCEL_URL="http://localhost:5174/dashboard/settings?upgrade=cancelled"

# ----- Email (SMTP via nodemailer) -----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="hello22.ai <support@hello22.ai>"
# Where support chat handoffs are emailed — blank falls back to SMTP_FROM
SUPPORT_INBOX_EMAIL=""

# ----- SMS (Twilio) -----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Regulatory docs for buying numbers in regulated countries (e.g. Australia).
# AddressSid (AD…) is required for AU; BundleSid (BU…) is usually required too.
# Set TWILIO_BUNDLE_SID_MOBILE only if AU mobile (+61 4) needs a different bundle
# than local/geographic numbers. Leave blank for US (no docs needed).
TWILIO_ADDRESS_SID=""
TWILIO_BUNDLE_SID=""
TWILIO_BUNDLE_SID_MOBILE=""

# ----- S3 (object storage for branding assets: logos + favicon) -----
# Works with AWS S3 or any S3-compatible provider (Cloudflare R2, MinIO…).
# The bucket should allow public reads on uploaded objects (or front it with a CDN).
AWS_S3_BUCKET=""
AWS_S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional — custom endpoint for S3-compatible providers (R2/MinIO)
AWS_S3_ENDPOINT=""
# Optional — CDN / custom domain used to build public asset URLs
AWS_S3_PUBLIC_URL=""

# ----- Call log tiering (server/src/services/callArchive.ts) -----
# call_logs is the biggest table in the schema, and three JSON columns
# (transcript, analysis, transcriptTranslated) are almost all of its weight.
# Past CALL_ARCHIVE_AFTER_DAYS those blobs move to S3 as one object per call and
# the columns are emptied; the ROW stays, so every number reports and billing
# read is unaffected. Opening an archived call rehydrates it transparently.
#
# Needs the AWS_* keys above - with storage unconfigured the sweep is a no-op
# and nothing is lost. 0 disables archiving.
CALL_ARCHIVE_AFTER_DAYS="90"
# Age at which a call log is DELETED outright, blob and all. 0 = never, and that
# is the default on purpose: these rows carry billed minutes and feed reports,
# so discarding them is a policy decision, not a default to inherit.
CALL_RETENTION_DAYS="0"

# ----- Per-tenant databases (docs/tenant-databases.md) -----
# Every brand gets a database of its own when it is created. With this key set
# that is a Neon project per brand (production); without it, a schema
# (tenant_<slug>) on the database above, through the same code path (dev).
# This key can create and DELETE any project on the account, so it is
# environment-only - never settable from admin, never returned by an endpoint.
NEON_API_KEY=""
# Region a tenant project is created in, e.g. aws-ap-southeast-2. Required
# whenever NEON_API_KEY is set: naming the jurisdiction is the point.
NEON_DEFAULT_REGION=""
# Only the Prisma CLI reads these two, when AUTHORING a tenant migration
# (prisma migrate diff --schema prisma/tenant/schema.prisma). Runtime never
# does - each tenant is opened with its own stored connection string.
TENANT_DATABASE_URL=""
TENANT_DIRECT_URL=""

# ----- Google Calendar (OAuth for calendar event creation) -----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Register EXACTLY this one URI in the Google Cloud console — never a brand's
# own domain. One callback serves every tenant; see CANONICAL_API_URL above.
GOOGLE_REDIRECT_URI="http://localhost:4000/api/google/callback"

# ----- WhatsApp (Meta Business Cloud API — post-call summaries & follow-ups) -----
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_AGENT_USER_ID=""
WHATSAPP_CALL_TEMPLATE=""

# ----- Nexleon CRM (central lead management — all call leads are pushed here) -----
PERFEX_CRM_URL="https://crm.nexleon.com"
PERFEX_CRM_FORM_KEY=""

# ----- Job queue (server/src/lib/jobQueue.ts, pg-boss) -----
# pg-boss stores its own queue tables in Postgres — no Redis. Blank reuses
# DATABASE_URL; only set this to isolate queue load onto a separate database.
JOB_QUEUE_DB_URL=""
JOB_QUEUE_SCHEMA="pgboss"
# Per-job cutover flags — each job migrated off scheduler.ts's setInterval onto
# the queue gets one, so flipping it back (no redeploy) is the rollback if the
# queue path misbehaves. Off by default.
JOBS_VIA_QUEUE_API_LOG_SWEEP="false"
JOBS_VIA_QUEUE_ALERT_RULES="false"
