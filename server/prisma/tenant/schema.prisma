// The shape of ONE brand's own database — the tenant plane.
//
// Every brand has one of these from the moment it is created (see
// services/tenantProvisioning.ts): a Neon project of its own in production, or
// a schema on the platform's database in development. All tenants share this
// schema and are kept on the same version by `npm run tenant:migrate`.
//
// The generated client lives beside the control-plane one and is imported as
// `@prisma/tenant-client`. The datasource URLs here are only for the Prisma CLI
// — at runtime a client is built per tenant with an explicit connection string
// (services/tenantDb.ts). Authoring a migration needs no database: diff the
// previous datamodel against this one —
//
//   npx prisma migrate diff --from-schema-datamodel <previous schema.prisma> \
//     --to-schema-datamodel prisma/tenant/schema.prisma --script \
//     > prisma/tenant/migrations/00NN_name/migration.sql
//
// FOREIGN KEYS, deliberately few. Rows here name their owner (`userId`) and
// the owner's agent record (`conversionId`) as plain ids while the mirrored
// copies of `users`, `profiles` and `conversions` are still being kept current
// from the control plane (phases 1–2b): a row that arrived a moment before its
// owner's mirror did must not be refused. The real foreign keys come in phase 6,
// when this database is the only copy. Keys between two tables written together
// by the same code (chat messages → conversation, webhook deliveries → CRM
// settings) are real already.

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/tenant-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("TENANT_DATABASE_URL")
  directUrl = env("TENANT_DIRECT_URL")
}

/// Exactly one row, written by provisioning: which brand this database belongs
/// to. `tenantFor()` reads it the first time it connects and refuses to serve a
/// brand from a database that names a different one — a mis-wired connection
/// string must fail loudly, never route one brand's customers into another's.
model TenantInfo {
  id            String   @id @default("self")
  brandId       String   @unique
  brandSlug     String
  provisionedAt DateTime @default(now())

  @@map("tenant_info")
}

/// Who an account is. The control plane's Role minus SUPER_ADMIN — the platform
/// owner never lives in a brand's database.
enum Role {
  USER
  ADMIN
  STAFF
  RESELLER
}

/// A brand's people: its customers, its admins, its staff, its resellers.
///
/// This is what sign-in and every session read — the brand's own database
/// answers "who is this, and what may they do" (phase 1 of
/// docs/tenant-db-expansion-plan.md). During the transition the control plane
/// keeps a mirror row with the SAME id, because profiles, tickets and numbers
/// there still point at it; services/identityMirror.ts writes both until those
/// tables move here (phases 2b–5), after which the mirror goes. Roles are still
/// the control plane's (`staffRoleId` is a plain id) until the support tables
/// move in phase 4.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(USER)
  /// Effective permission keys for STAFF, denormalised from their role.
  permissions  String[] @default([])
  staffRoleId  String?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  /// Reseller/affiliate: a RESELLER has a code and a rate; a customer referred
  /// by one carries referredById (a plain id — both live in this database).
  referralCode      String? @unique
  commissionPercent Float   @default(0)
  referredById      String?
  referredBy        User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]  @relation("Referrals")

  emailOptOutAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The customer's workspace (phase 6). Real relations now that everything
  // hangs off an account that lives here: delete the account, its workspace goes.
  profile           Profile?
  conversion        Conversion?
  couponRedemptions CouponRedemption[]
  commissionsEarned Commission[] @relation("ResellerCommissions")
  commissionsFrom   Commission[] @relation("CustomerCommissions")

  // Support (phase 4). These are real relations: a thread with no requester
  // and a grant on no account are not worth keeping.
  notifications      Notification[]
  ticketsRequested   Ticket[]           @relation("TicketRequester")
  ticketsAssigned    Ticket[]           @relation("TicketAssignee")
  ticketDepartments  TicketDepartment[] @relation("StaffTicketDepartments")
  ticketSavedReplies TicketSavedReply[] @relation("SavedReplyAuthor")

  @@map("users")
}

enum CallType {
  Web
  Phone
}

enum CallOutcome {
  completed
  missed
  failed
  voicemail
}

/// A call, whole — the caller's words and the call's structure in one row, in
/// the brand's own database (phase 2a). RANGE-partitioned on `createdAt`, one
/// partition per month, in SQL (migration 0003); Prisma does not model
/// partitioning, so this describes the columns only. The partition key sits in
/// every unique constraint because Postgres demands it.
///
/// `conversionId` is a plain id: see the note on foreign keys at the top.
model CallLog {
  id           String @default(cuid())
  conversionId String

  type                CallType    @default(Web)
  callerName          String      @default("Unknown")
  callerNumber        String      @default("")
  durationSec         Int         @default(0)
  outcome             CallOutcome @default(completed)
  summary             String      @default("")
  /// Short caller purpose/category (few words) for the SMS summary.
  purpose             String      @default("")
  /// "booking" | "lead" | "enquiry" | "support" | "spam", or "" when unclassified.
  intent              String      @default("")
  /// Who set `intent`: "ai" or "user". A user value is never overwritten by AI.
  intentSource        String      @default("ai")
  requestedDepartment String      @default("")
  /// "connected" | "failed" | "" — see the control plane's model for the story.
  transferOutcome     String      @default("")
  recordingUrl        String?
  vapiCallId          String?

  // The three JSON blobs are the bulk of the row. Past CALL_ARCHIVE_AFTER_DAYS
  // they move to S3 as one object and these columns are emptied — see
  // services/callArchive.ts.
  transcript Json @default("[]")
  analysis   Json @default("{}")

  transcriptTranslated     Json?
  transcriptTranslatedLang String?
  summaryTranslated        String?

  /// Public, unguessable slug + expiry for the shared conversation page. The
  /// control plane's `call_shares` says which brand's database a slug is in.
  publicId       String?
  shareExpiresAt DateTime?

  blobKey        String?
  blobArchivedAt DateTime?

  createdAt DateTime @default(now())

  @@id([id, createdAt])
  @@unique([publicId, createdAt])
  @@index([conversionId, createdAt])
  @@index([conversionId, intent])
  @@index([createdAt])
  @@map("call_logs")
}

// ------------------------------------------------------------------
//  The customer's workspace (phase 2b).
//
//  Two of these tables are MIRRORS for now — `profiles` and `conversions`
//  are still written in the control plane, where billing, approvals and
//  the platform's views read them, and copied here by
//  services/workspaceMirror.ts on every write. They become the only copy
//  with phase 3 (money) and phase 6. Everything else below is written and
//  read HERE and nowhere else.
// ------------------------------------------------------------------

enum Plan {
  free
  premium
}

/// MIRROR of the control plane's `profiles` row (same id, same columns minus
/// the brand — the database is the brand). Plain ids where the control plane
/// has relations: `subscriptionPlanId`, `activeCouponRedemptionId`,
/// `scheduledPlanId` name rows that are still the platform's until phase 3.
/// Column meanings: see the control plane's schema.
model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName   String @default("")
  mobile         String @default("")
  website        String @default("")
  businessNumber String @default("")
  address        String @default("")
  country        String @default("")
  timezone       String @default("")
  industry       String @default("")
  plan           Plan   @default(free)

  testMinutesUsed    Float    @default(0)
  webTestMinutesUsed Float    @default(0)
  webTestCycleStart  DateTime @default(now())

  /// The number this customer holds. The number itself — inventory, Twilio
  /// identity, price — stays in the control plane's `phone_numbers`; who holds
  /// it is recorded here (plan §4.5).
  receptionistNumber String  @default("")
  numberActivated    Boolean @default(false)
  /// The inventory row (control plane `phone_numbers.id`) behind
  /// receptionistNumber — a plain id, so the two sides can be checked against
  /// each other by the reclaim sweep.
  phoneNumberId      String?

  forwardingMode        String    @default("")
  forwardingConfirmedAt DateTime?

  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?
  quickSetupSeenAt      DateTime?

  subscriptionPlanId   String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String    @default("none")
  cardRequiredAtSignup Boolean   @default(false)
  cardConfirmedAt      DateTime?
  suspendedAt          DateTime?
  autoRenew            Boolean   @default(true)
  trialEndsAt          DateTime?
  cardFingerprint      String?   @unique

  trialStartedAt        DateTime?
  trialMinutesAllocated Float?
  trialSecondsUsed      Float     @default(0)
  trialStatus           String    @default("active")

  planMinutesAllocated Float?
  planSecondsUsed      Float     @default(0)
  currentPeriodEnd     DateTime?

  usageAlertsSent String @default("")

  graceStartedAt   DateTime?
  graceEndsAt      DateTime?
  graceNotifyStage String?
  graceConsumedAt  DateTime?

  scheduledPlanId          String?
  scheduledPlanEffectiveAt DateTime?
  stripeScheduleId         String?

  pendingSwitchCustomerId     String?
  pendingSwitchSubscriptionId String?
  pendingSwitchPlanId         String?
  pendingSwitchStartedAt      DateTime?

  activeCouponRedemptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("profiles")
}

/// MIRROR of the control plane's `conversions` row — the customer's AI agent:
/// its configuration, approval state and live Vapi assistant. Same id.
model Conversion {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentConfig            Json
  dataCaptureFields      Json    @default("[]")
  promptTemplateSnapshot String?

  status     String    @default("pending")
  approvedAt DateTime?

  vapiAssistantId   String?
  vapiSyncPendingAt DateTime?
  vapiSyncNextAt    DateTime?
  vapiSyncAttempts  Int       @default(0)
  vapiSyncError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vapiSyncNextAt])
  @@map("conversions")
}

/// The customer's CRM and booking settings. Lives here only.
model CrmIntegration {
  id     String @id @default(cuid())
  userId String @unique

  connectedProvider       String?
  googleCalendarConnected Boolean @default(false)
  customWebhookUrl        String  @default("")
  nexleonUrl              String? @map("perfexUrl")
  nexleonFormKey          String? @map("perfexFormKey")

  bookingEnabled     Boolean @default(false)
  bookingDurationMin Int     @default(30)
  bookingCalendarId  String  @default("primary")
  bookingTimezone    String  @default("")
  bookingLinkEnabled Boolean @default(false)
  bookingUrl         String  @default("")
  bookingLabel       String  @default("appointment")
  bookingFields      String  @default("")
  bookingHours       String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookDeliveries WebhookDelivery[]

  @@map("crm_integrations")
}

/// Every lead pushed to a CRM, and how it went. `callLogId` names a row in
/// this database's `call_logs`. Lives here only.
model WebhookDelivery {
  id               String          @id @default(cuid())
  crmIntegrationId String?
  crmIntegration   CrmIntegration? @relation(fields: [crmIntegrationId], references: [id], onDelete: Cascade)
  callLogId        String?

  provider     String
  url          String
  status       Int
  success      Boolean
  payload      Json
  responseBody String  @default("")
  errorMessage String  @default("")
  durationMs   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([crmIntegrationId, createdAt])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

/// Human call transfer — the single-number settings. Lives here only.
model HumanTransferSettings {
  id     String @id @default(cuid())
  userId String @unique

  enabled         Boolean @default(false)
  transferNumber  String  @default("")
  ringTimeoutSec  Int     @default(25)
  fallbackMessage String  @default("Our support team isn't available right now. We've recorded your request and will contact you as soon as possible. Thank you for calling.")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("human_transfer_settings")
}

/// Human call transfer — the departments a caller can be handed to. Lives here only.
model TransferDepartment {
  id     String @id @default(cuid())
  userId String

  name            String
  number          String  @default("")
  description     String  @default("")
  enabled         Boolean @default(true)
  ringTimeoutSec  Int     @default(15)
  fallbackMessage String  @default("Our team isn't available right now. We've recorded your request and will contact you as soon as possible. Thank you for calling.")
  order           Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("transfer_departments")
}

/// An appointment the AI (or the owner) booked. Lives here only.
model Appointment {
  id     String @id @default(cuid())
  userId String

  customerName  String @default("")
  customerPhone String @default("")
  customerEmail String @default("")
  notes         String @default("")

  startAt  DateTime
  endAt    DateTime
  timezone String   @default("")

  /// confirmed | cancelled
  status        String @default("confirmed")
  /// ai | manual
  source        String @default("ai")
  googleEventId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startAt])
  @@map("booking_appointments")
}

/// The customer's support-chat thread with the assistant. Lives here only.
model ChatConversation {
  id            String   @id @default(cuid())
  userId        String
  humanTakeover Boolean  @default(false)
  createdAt     DateTime @default(now())

  messages ChatMessage[]

  @@index([userId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "user" | "assistant" | "human"
  role           String
  content        String
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

enum VerificationPurpose {
  signup
  password_reset
  impersonation_pin_reset
}

/// One-time codes issued on this brand's door: sign-up verification, password
/// reset, PIN reset. The platform's own people get theirs from the control
/// plane's table of the same shape (services/otp.ts picks by door).
model VerificationCode {
  id         String              @id @default(cuid())
  email      String
  purpose    VerificationPurpose
  codeHash   String
  payload    Json?
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([email, purpose])
  @@map("verification_codes")
}

/// One customer's use of one coupon. The coupon itself (code, rules, Stripe
/// coupon id) is the platform's catalogue in the control plane; this row is the
/// customer's side of it — reserved at sign-up, applied when the subscription
/// starts, ended or revoked later. Moved whole from Main in phase 6.
///
///   pending   — reserved, waiting for the subscription that will carry it
///   active    — applied to the live subscription
///   ended     — ran its cycles, or the subscription ended
///   revoked   — cancelled early. Still blocks re-entry unless the admin
///               released the slot, which deletes the row instead.
model CouponRedemption {
  id       String @id @default(cuid())
  couponId String
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status               String    @default("pending")
  cyclesUsed           Int       @default(0)
  lastCountedPeriodEnd DateTime?
  lastCountedInvoiceId String?

  reservedAt DateTime  @default(now())
  appliedAt  DateTime?
  endedAt    DateTime?
  grantedBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([couponId, userId])
  @@index([userId, status])
  @@index([couponId, status])
  @@map("coupon_redemptions")
}

/// A commission credit for a reseller, accrued from a referred customer's
/// payment. Both accounts are the brand's, so the row is the brand's too
/// (phase 6; a deviation from the plan's table, which listed it under Main —
/// nothing in it belongs to the platform).
model Commission {
  id         String @id @default(cuid())
  resellerId String
  reseller   User   @relation("ResellerCommissions", fields: [resellerId], references: [id], onDelete: Cascade)
  customerId String
  customer   User   @relation("CustomerCommissions", fields: [customerId], references: [id], onDelete: Cascade)

  amountCents        Int
  percent            Float
  invoiceAmountCents Int
  stripeInvoiceId    String?
  /// pending | paid
  status             String  @default("pending")

  createdAt DateTime @default(now())

  @@index([resellerId, createdAt])
  @@map("commissions")
}

/// The customer's billing history, as they and their brand's admin see it:
/// "Professional plan, October — $75". One row per lifecycle moment
/// (services/planHistory.ts). The platform's share of each payment is in the
/// control plane's ledger, not here. Lives here only (phase 3).
model PlanEvent {
  id     String @id @default(cuid())
  userId String

  /// trial_started | trial_converted | upgraded | downgrade_scheduled | downgraded |
  /// downgrade_canceled | plan_switched | renewed | canceled | auto_renew_off |
  /// auto_renew_on | coupon_applied | coupon_expired | coupon_reattached
  type         String
  fromPlanId   String?
  fromPlanName String?
  toPlanId     String?
  toPlanName   String?
  priceCents   Int     @default(0)
  currency     String  @default("usd")
  amountCents  Int     @default(0)
  note         String  @default("")

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("plan_events")
}

// ------------------------------------------------------------------
//  Support (phase 4). The brand's inbox — its customers' tickets, the
//  queues they file into, the team's saved replies, the staff roles that
//  grant those queues — and every notification a brand's person gets.
//  Identical in shape to the control plane's tables, which hold the
//  OTHER lane (a brand admin asking the platform): the same code serves
//  both through `laneDb()` (services/tenantDb.ts).
//
//  `users.staffRoleId` stays a plain id in both planes: the role lives in
//  the plane the account does, and this database's staff_roles is
//  filled by the brand's own admin, not mirrored.
// ------------------------------------------------------------------

enum TicketLane {
  /// Customer → their brand's admin team.
  support
  /// Brand admin → the platform (super admin). Never on a tenant's rows.
  brand
}

enum TicketStatus {
  open
  pending
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

/// A brand's named staff roles: a permission bundle plus the queues it works.
model StaffRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  permissions String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketDepartments TicketDepartment[] @relation("StaffRoleTicketDepartments")

  @@map("staff_roles")
}

model TicketDepartment {
  id   String     @id @default(cuid())
  lane TicketLane

  /// The brand whose queue this is — always this database's own brand on
  /// lane `support`. Kept so the shape matches the control plane's table.
  brandId String?

  name             String
  description      String  @default("")
  requesterVisible Boolean @default(true)
  enabled          Boolean @default(true)
  order            Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles   StaffRole[] @relation("StaffRoleTicketDepartments")
  staff   User[]      @relation("StaffTicketDepartments")
  tickets Ticket[]

  savedReplies TicketSavedReply[]

  @@unique([brandId, lane, name])
  @@index([lane, brandId, order])
  @@map("ticket_departments")
}

model TicketSavedReply {
  id    String     @id @default(cuid())
  lane  TicketLane
  title String
  body  String

  brandId String?

  departmentId String?
  department   TicketDepartment? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("SavedReplyAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lane, brandId, title])
  @@map("ticket_saved_replies")
}

/// A customer's request to the brand's team — the whole thread lives here.
model Ticket {
  id        String @id @default(cuid())
  number    Int    @unique @default(autoincrement())
  reference String @unique
  subject   String

  lane     TicketLane
  status   TicketStatus   @default(open)
  priority TicketPriority @default(normal)

  /// The requester's brand — this database's own.
  brandId String?

  departmentId String?
  department   TicketDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  requesterId String
  requester   User   @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  /// The customer ticket a platform ticket was raised from — only ever set on
  /// the control plane's rows; here for the shared shape.
  escalatedFromId      String? @unique
  escalatedFromBrandId String?
  /// The platform ticket (in the control plane) this thread was escalated to.
  /// The pair is looked up across planes; see attachEscalationPairs.
  escalationId         String?

  /// Who asked, as of when they asked.
  requesterBrandId String?
  requesterName    String  @default("")
  requesterEmail   String  @default("")

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  source String @default("app")

  lastMessageAt      DateTime @default(now())
  unreadForStaff     Boolean  @default(true)
  unreadForRequester Boolean  @default(false)

  staffReadAt     DateTime?
  requesterReadAt DateTime?

  rating        Int?
  ratingComment String    @default("")
  ratedAt       DateTime?

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages    TicketMessage[]
  attachments TicketAttachment[]
  merges      TicketMerge[]

  @@index([lane, brandId, status, lastMessageAt])
  @@index([lane, brandId, lastMessageAt])
  @@index([departmentId, lastMessageAt])
  @@index([requesterId, lastMessageAt])
  @@index([assignedToId, lastMessageAt])
  @@index([rating])
  @@map("tickets")
}

model TicketMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// requester | staff | system
  authorType String
  authorId   String?
  authorName String  @default("")

  body     String  @default("")
  internal Boolean @default(false)

  replyToId String?
  replyTo   TicketMessage?  @relation("TicketMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   TicketMessage[] @relation("TicketMessageReplies")

  editedAt  DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())

  attachments TicketAttachment[]
  reactions   TicketMessageReaction[]

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketMerge {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  sourceNumber        Int
  sourceReference     String
  sourceSubject       String
  sourceRequesterName String   @default("")
  sourceCreatedAt     DateTime
  messageCount        Int      @default(0)

  mergedById   String?
  mergedByName String   @default("")
  mergedAt     DateTime @default(now())

  @@index([ticketId, mergedAt])
  @@map("ticket_merges")
}

model TicketMessageReaction {
  id        String        @id @default(cuid())
  messageId String
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  emoji     String
  actorKey  String
  actorType String
  actorName String @default("")

  createdAt DateTime @default(now())

  @@unique([messageId, actorKey, emoji])
  @@index([messageId])
  @@map("ticket_message_reactions")
}

model TicketAttachment {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  messageId String?
  message   TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  name String
  mime String
  size Int
  key  String
  url  String

  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_attachments")
}

/// A brand's person's in-app notifications. The platform's own people keep
/// theirs in the control plane's table of the same shape (services/notifications.ts).
model Notification {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// missed_call | new_lead | billing | agent | system | ticket
  type    String
  title   String
  message String  @default("")
  link    String?
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}
